<div class="home r-{{ page.page_options.radius | escape }}">
  {% if page.page_options.show_hero %}
    <section class="hero">
      {% if page.page_options.hero.image != "" %}
        <img class="hero-image" src="{{ page.page_options.hero.image }}" alt="" />
      {% endif %}
      <div class="hero-text">
        <h1>{{ page.page_options.hero.title | default: page.title | escape }}</h1>
        {% if page.page_options.hero.tagline != "" %}<p>{{ page.page_options.hero.tagline | escape }}</p>{% endif %}
        {% if page.page_options.hero.cta_label != "" and page.page_options.hero.cta_url != "" %}
          <a class="button" href="{{ page.page_options.hero.cta_url }}">{{ page.page_options.hero.cta_label | escape }}</a>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if page.page_options.show_featured and page.page_options.featured != empty %}
    <section class="featured">
      {% if page.page_options.featured_title != "" %}<h2 class="section-title">{{ page.page_options.featured_title | escape }}</h2>{% endif %}
      <ul class="feature-grid">
        {% for item in page.page_options.featured %}
          <li>
            <a href="{{ item.url | default: '#' }}">
              {% if item.image != "" %}<img src="{{ item.image }}" alt="" loading="lazy" />{% endif %}
              <span class="feature-title">{{ item.title | escape }}</span>
              {% if item.kicker != "" %}<span class="feature-kicker">{{ item.kicker | escape }}</span>{% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if page.page_options.show_statement %}
    <section class="statement{% if page.page_options.statement.portrait != "" %} has-portrait{% endif %}">
      <div>
        {% if page.page_options.statement.title != "" %}<h2 class="section-title">{{ page.page_options.statement.title | escape }}</h2>{% endif %}
        {% if page.page_options.statement.text != "" %}<p>{{ page.page_options.statement.text | escape }}</p>{% endif %}
      </div>
      {% if page.page_options.statement.portrait != "" %}
        <img src="{{ page.page_options.statement.portrait }}" alt="" loading="lazy" />
      {% endif %}
    </section>
  {% endif %}

  {% if page.page_options.show_journal and posts != empty %}
    <section class="journal">
      {% if page.page_options.journal_title != "" %}<h2 class="section-title">{{ page.page_options.journal_title | escape }}</h2>{% endif %}
      <ul class="post-list">
        {% for post in posts limit: page.page_options.journal_count %}
          <li>
            <a href="{{ post.url }}">
              {% if post.post_options.cover != "" %}
                <img class="post-thumb" src="{{ post.post_options.cover }}" alt="{{ post.post_options.cover_alt | escape }}" loading="lazy" />
              {% endif %}
              <h3>{{ post.title | escape }}</h3>
              {% if post.excerpt != "" %}<p class="excerpt">{{ post.excerpt | escape }}</p>{% endif %}
              {% if post.published_at %}
                <time datetime="{{ post.published_at | iso8601 }}">{{ post.published_at | strftime: "%B %-d, %Y" }}</time>
              {% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
</div>
