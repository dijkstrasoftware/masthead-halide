{
  "name": "Halide",
  "slug": "halide",
  "version": "1.1.3",
  "author": "Masthead",
  "description": "A dark, quiet portfolio theme for photographers. Galleries do the talking.",
  "tokens": [
    {
      "key": "bg",
      "label": "Background color",
      "type": "color",
      "default": "#0e0e10",
      "category": "Appearance"
    },
    {
      "key": "fg",
      "label": "Text color",
      "type": "color",
      "default": "#ece9e4",
      "category": "Appearance"
    },
    {
      "key": "accent",
      "label": "Accent color",
      "type": "color",
      "default": "#c8a45c",
      "category": "Appearance"
    },
    {
      "key": "max",
      "label": "Content width",
      "type": "length",
      "default": "1100px",
      "category": "Appearance"
    },
    {
      "key": "favicon",
      "label": "Favicon",
      "type": "file",
      "default": "",
      "category": "Appearance"
    },
    {
      "key": "show_search",
      "label": "Show post search",
      "type": "boolean",
      "default": false,
      "category": "Posts"
    },
    {
      "key": "show_tags",
      "label": "Show tags on posts",
      "type": "boolean",
      "default": false,
      "category": "Posts"
    }
  ],
  "metadata": [
    {
      "key": "layout",
      "label": "Page layout",
      "type": "select",
      "options": ["contained", "wide"],
      "default": "contained",
      "description": "Use 'wide' to escape the max-width container (e.g. for a full-bleed landing page)."
    },
    {
      "key": "show_navigation",
      "label": "Show site navigation",
      "type": "boolean",
      "default": true,
      "description": "Untick to hide the top nav bar on this page only."
    }
  ]
}
